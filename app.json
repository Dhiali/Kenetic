{
  "expo": {
    "name": "kenetic",
    "slug": "kenetic",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "kenetic uses your camera to identify natural patterns during Outdoors sessions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "kenetic uses your camera to identify natural patterns during Outdoors sessions."
        }
      ]
    ]
  }
}
