rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validSession() {
      return request.resource.data.keys().hasAll(['type', 'status', 'startedAt'])
        && request.resource.data.type in ['focus', 'breathe', 'outdoors']
        && request.resource.data.status in ['started', 'completed', 'abandoned']
        && request.resource.data.startedAt is timestamp
        && (!('durationSeconds' in request.resource.data)
          || (request.resource.data.durationSeconds is number
            && request.resource.data.durationSeconds >= 0
            && request.resource.data.durationSeconds <= 86400))
        && (!('completedAt' in request.resource.data)
          || request.resource.data.completedAt is timestamp)
        && (!('metadata' in request.resource.data)
          || request.resource.data.metadata is map);
    }

    function validSessionUpdate() {
      return validSession()
        && request.resource.data.type == resource.data.type
        && request.resource.data.startedAt == resource.data.startedAt;
    }

    function validNotificationPreference() {
      return !('notificationPreference' in request.resource.data)
        || request.resource.data.notificationPreference in ['later', 'sure'];
    }

    function validUserProfile() {
      return request.resource.data.keys().hasAll(['onboardingCompleted'])
        && request.resource.data.onboardingCompleted is bool
        && (!('displayName' in request.resource.data)
          || request.resource.data.displayName is string)
        && (!('email' in request.resource.data)
          || request.resource.data.email is string)
        && (!('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl is string)
        && (!('termsAccepted' in request.resource.data)
          || request.resource.data.termsAccepted is bool)
        && (!('termsAcceptedAt' in request.resource.data)
          || request.resource.data.termsAcceptedAt is timestamp)
        && validNotificationPreference();
    }

    function validTermsUpdate() {
      return resource.data.termsAccepted != true
        || (request.resource.data.termsAccepted == true
          && request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt);
    }

    function validCoordinates(data) {
      return (!('latitude' in data)
          || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data)
          || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /features/{featureId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /admin/{documentId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, delete: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && validUserProfile()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if ownsUser(userId)
        && validUserProfile()
        && validTermsUpdate()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      match /sessions/{sessionId} {
        allow read, delete: if ownsUser(userId);
        allow create: if ownsUser(userId) && validSession();
        allow update: if ownsUser(userId) && validSessionUpdate();
      }

      match /metrics/{metricId} {
        // Aggregate metrics are server-managed. Clients may read but never write them.
        allow read: if ownsUser(userId);
        allow create, update: if false;
        allow delete: if ownsUser(userId);
      }

      match /notificationEvents/{eventId} {
        allow read, delete: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['type', 'createdAt'])
          && request.resource.data.type in [
            'permission-requested',
            'permission-granted',
            'permission-denied',
            'token-updated'
          ]
          && request.resource.data.createdAt is timestamp
          && (!('platform' in request.resource.data)
            || request.resource.data.platform in ['ios', 'android', 'web'])
          && (!('metadata' in request.resource.data)
            || request.resource.data.metadata is map);
        allow update: if false;
      }

      match /devices/{deviceId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll([
            'token',
            'platform',
            'enabled',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.platform in ['ios', 'android', 'web']
          && request.resource.data.enabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      match /scanHistory/{scanId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['source', 'title', 'capturedAt'])
          && request.resource.data.source in ['camera', 'microphone', 'manual']
          && request.resource.data.title is string
          && request.resource.data.capturedAt is timestamp
          && validCoordinates(request.resource.data)
          && (!('summary' in request.resource.data)
            || request.resource.data.summary is string)
          && (!('ecologicalSignificance' in request.resource.data)
            || request.resource.data.ecologicalSignificance is string)
          && (!('latitude' in request.resource.data)
            || request.resource.data.latitude is number)
          && (!('longitude' in request.resource.data)
            || request.resource.data.longitude is number);
      }

      match /challengeProgress/{challengeId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['challengeId', 'status'])
          && request.resource.data.challengeId is string
          && request.resource.data.status in ['available', 'started', 'completed']
          && request.resource.data.challengeId == challengeId
          && (!('startedAt' in request.resource.data)
            || request.resource.data.startedAt is timestamp)
          && (!('completedAt' in request.resource.data)
            || request.resource.data.completedAt is timestamp)
          && (!('metadata' in request.resource.data)
            || request.resource.data.metadata is map);
      }

      match /savedPlaces/{placeId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['placeId', 'name', 'savedAt'])
          && request.resource.data.placeId is string
          && request.resource.data.name is string
          && request.resource.data.savedAt is timestamp
          && request.resource.data.placeId == placeId
          && validCoordinates(request.resource.data)
          && (!('address' in request.resource.data)
            || request.resource.data.address is string)
          && (!('category' in request.resource.data)
            || request.resource.data.category is string);
      }

      match /intentions/{intentionId} {
        allow read: if ownsUser(userId);
        allow delete: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && intentionId == 'current'
          && request.resource.data.keys().hasAll([
            'value',
            'source',
            'selectedAt',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.value in ['deep work', 'nature', 'peace']
          && request.resource.data.source == 'onboarding'
          && request.resource.data.selectedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if ownsUser(userId)
          && intentionId == 'current'
          && request.resource.data.keys().hasAll([
            'value',
            'source',
            'selectedAt',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.value in ['deep work', 'nature', 'peace']
          && request.resource.data.source == 'onboarding'
          && request.resource.data.selectedAt is timestamp
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp;
      }

      match /dashboardSelections/{selectionId} {
        allow read, delete: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['state', 'source', 'selectedAt'])
          && request.resource.data.state in ['focus', 'outdoors', 'breathe']
          && request.resource.data.source == 'dashboard'
          && request.resource.data.selectedAt is timestamp;
        allow update: if false;
      }

      match /focusFeatureLaunches/{launchId} {
        allow read, delete: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasAll(['feature', 'source', 'launchedAt'])
          && request.resource.data.feature in ['get-shit-done', 'alien-mode']
          && request.resource.data.source == 'focus-dashboard'
          && request.resource.data.launchedAt is timestamp;
        allow update: if false;
      }
    }
  }
}
