{
  "name": "kenetic",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck:app": "tsc --project tsconfig.app.json --noEmit",
    "typecheck:functions": "npm --prefix functions run build",
    "test:outdoor-data": "node --test scripts/test-outdoor-data.cjs",
    "test:focus-timing": "node --test scripts/test-focus-timing.cjs",
    "test:auth": "node --test scripts/test-auth.cjs",
    "test:account-restore": "node --test scripts/test-account-restore.cjs",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-kenetic-rules \"node scripts/test-firestore-rules.cjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage --project demo-kenetic-rules \"node scripts/test-storage-rules.cjs\"",
    "test:breathing": "node --test scripts/test-breathing.cjs",
    "test:curated-quiz": "node --test scripts/test-curated-quiz.cjs",
    "test:session-storage": "node --test scripts/test-session-storage.cjs",
    "test:ai-worker": "node --test scripts/test-ai-worker.mjs",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "firebase:emulators": "firebase emulators:start",
    "firebase:seed": "npm --prefix functions run seed",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.18.0",
    "lucide-react-native": "^0.454.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "firebase-tools": "^14.16.0",
    "typescript": "^5.3.3"
  }
}
